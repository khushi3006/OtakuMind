generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  output          = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String   @unique
  password  String
  name      String?
  bio       String?
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())
  animes    Anime[]

  // Social graph (self-referential many-to-many through Follow)
  following Follow[] @relation("Follower")
  followers Follow[] @relation("Following")

  @@index([username])
}

model Follow {
  id          Int      @id @default(autoincrement())
  followerId  Int
  followingId Int
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Anime {
  id                Int       @id @default(autoincrement())
  name              String
  normalizedName    String
  season            Int
  episodesWatched   Int       @default(0)
  totalEpisodes     Int       @default(0)
  status            String // "completed", "incomplete", "dropped"
  imageUrl          String?
  malId             Int? // For Jikan API linking (removed @unique for multi-user compatibility)
  type              String    @default("TV") // "TV", "Movie", "OVA", "Special"
  originalOrder     Int? // Preserves the number from 1-601
  watchOrder        Int? // Custom drag-and-drop ordering for "Currently Watching"
  droppedAt         DateTime?
  completedAt       DateTime?
  airing            Boolean   @default(false)
  broadcastDay      String?
  broadcastTime     String?
  broadcastTimezone String?
  broadcastString   String?
  airingStart       String?
  createdAt         DateTime  @default(now())

  // Owner relation
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Performance indexes and user-scoped uniqueness.
  // Season uniqueness is a PARTIAL unique index covering TV rows only:
  //   CREATE UNIQUE INDEX ... (userId, normalizedName, season) WHERE type = 'TV'
  // Prisma can't model partial indexes, so it lives in the migration
  // 20260605000000_partial_season_unique (mirror: scripts/migrate-partial-season.ts),
  // not as an @@unique() here. Movies/OVAs/Specials are intentionally left
  // unconstrained so they never consume TV season slots.
  @@index([userId, status, createdAt])
  @@index([userId, status, droppedAt])
  @@index([userId, status, completedAt])
  @@index([userId, status, originalOrder])
  @@index([userId, status, watchOrder])
  @@index([userId, normalizedName])
}
