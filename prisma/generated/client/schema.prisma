generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  output          = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String   @unique
  password  String
  name      String?
  bio       String?
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())
  animes    Anime[]

  // Social graph (self-referential many-to-many through Follow)
  following Follow[] @relation("Follower")
  followers Follow[] @relation("Following")

  passwordResetTokens PasswordResetToken[]

  @@index([username])
}

// Holds signup details + hashed OTP until the email is verified. No User row
// exists until verification succeeds (see /api/auth/signup/verify).
model PendingSignup {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String?
  username     String?
  passwordHash String
  otpHash      String
  attempts     Int      @default(0)
  expiresAt    DateTime
  lastSentAt   DateTime @default(now())
  createdAt    DateTime @default(now())
}

// Single-use, time-limited tokens for the password-reset link flow.
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Follow {
  id          Int      @id @default(autoincrement())
  followerId  Int
  followingId Int
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Anime {
  id                Int       @id @default(autoincrement())
  name              String
  normalizedName    String
  season            Int
  part              Int? // null = normal single season; 1,2,… = a split-cour part
  episodesWatched   Int       @default(0)
  totalEpisodes     Int       @default(0)
  status            String // "completed", "incomplete", "dropped"
  imageUrl          String?
  malId             Int? // For Jikan API linking (removed @unique for multi-user compatibility)
  type              String    @default("TV") // "TV", "Movie", "OVA", "Special"
  originalOrder     Int? // Preserves the number from 1-601
  watchOrder        Int? // Custom drag-and-drop ordering for "Currently Watching"
  droppedAt         DateTime?
  completedAt       DateTime?
  airing            Boolean   @default(false)
  broadcastDay      String?
  broadcastTime     String?
  broadcastTimezone String?
  broadcastString   String?
  airingStart       String?
  createdAt         DateTime  @default(now())

  // Owner relation
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Performance indexes and user-scoped uniqueness.
  // Season uniqueness is a PARTIAL unique index covering TV rows only, now part-aware:
  //   CREATE UNIQUE INDEX ... (userId, normalizedName, season, part)
  //     NULLS NOT DISTINCT WHERE type = 'TV'
  // Prisma can't model partial / NULLS NOT DISTINCT indexes, so it lives in the
  // migration 20260605120000_add_season_part (mirror: scripts/migrate-add-season-part.ts),
  // not as an @@unique() here. Movies/OVAs/Specials stay unconstrained.
  @@index([userId, status, createdAt])
  @@index([userId, status, droppedAt])
  @@index([userId, status, completedAt])
  @@index([userId, status, originalOrder])
  @@index([userId, status, watchOrder])
  @@index([userId, normalizedName])
}
