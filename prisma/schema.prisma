generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  output          = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  animes    Anime[]
}

model Anime {
  id               Int      @id @default(autoincrement())
  name             String
  normalizedName   String
  season           Int
  episodesWatched  Int      @default(0)
  totalEpisodes    Int      @default(0)
  status           String   // "completed", "incomplete", "dropped"
  imageUrl         String?
  malId            Int?     // For Jikan API linking (removed @unique for multi-user compatibility)
  type             String   @default("TV") // "TV", "Movie", "OVA", "Special"
  originalOrder    Int?     // Preserves the number from 1-601
  watchOrder       Int?     // Custom drag-and-drop ordering for "Currently Watching"
  droppedAt        DateTime?
  completedAt      DateTime?
  airing           Boolean  @default(false)
  broadcastDay     String?
  broadcastTime    String?
  broadcastTimezone String?
  broadcastString  String?
  airingStart      String?
  createdAt        DateTime @default(now())

  // Owner relation (optional temporarily to allow migrating existing rows without owner)
  userId           Int?
  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Performance indexes and user-scoped uniqueness
  @@unique([userId, normalizedName, season])
  @@index([userId, status, createdAt])
  @@index([userId, status, droppedAt])
  @@index([userId, status, completedAt])
  @@index([userId, status, originalOrder])
  @@index([userId, status, watchOrder])
  @@index([userId, normalizedName])
}
