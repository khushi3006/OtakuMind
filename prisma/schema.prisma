generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  output          = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String   @unique
  password  String
  name      String?
  bio       String?
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())
  // Paid plan — account-wide entitlement (14-day trial + ₹299 lifetime).
  hasLifetime         Boolean   @default(false) // a real purchase happened (Apple IAP or Razorpay)
  lifetimePurchasedAt DateTime?
  lifetimeEventAt     DateTime? // event_timestamp of the last applied RevenueCat webhook event; guards out-of-order / duplicate delivery
  grandfathered       Boolean   @default(false) // free, pre-launch account
  animes    Anime[]

  // Social graph (self-referential many-to-many through Follow)
  following Follow[]  @relation("Follower")
  followers Follow[]  @relation("Following")

  // Moderation (App Store UGC requirement): blocks I created / blocks against me, and reports.
  blocksMade     Block[]  @relation("Blocker")
  blocksAgainst  Block[]  @relation("Blocked")
  reportsMade    Report[] @relation("Reporter")
  reportsAgainst Report[] @relation("Reported")

  passwordResetTokens PasswordResetToken[]

  @@index([username])
}

// A directed block edge: the blocker no longer sees / can be contacted by the blocked
// account (filtering is applied in both directions). Removing either user cascades.
model Block {
  id        Int      @id @default(autoincrement())
  blockerId Int
  blockedId Int
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

// A user-submitted report of another account (objectionable content / abuse).
model Report {
  id             Int      @id @default(autoincrement())
  reporterId     Int
  reportedUserId Int
  reason         String
  details        String?
  status         String   @default("open")
  createdAt      DateTime @default(now())

  reporter User @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User @relation("Reported", fields: [reportedUserId], references: [id], onDelete: Cascade)

  @@index([reportedUserId])
  @@index([status])
}

// Holds signup details + hashed OTP until the email is verified. No User row
// exists until verification succeeds (see /api/auth/signup/verify).
model PendingSignup {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String?
  username     String?
  passwordHash String
  otpHash      String
  attempts     Int      @default(0)
  expiresAt    DateTime
  lastSentAt   DateTime @default(now())
  createdAt    DateTime @default(now())
}

// Single-use, time-limited tokens for the password-reset link flow.
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Follow {
  id          Int      @id @default(autoincrement())
  followerId  Int
  followingId Int
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Anime {
  id               Int      @id @default(autoincrement())
  name             String
  normalizedName   String
  season           Int
  part             Int?     // null = normal single season; 1,2,… = a split-cour part
  episodesWatched  Int      @default(0)
  totalEpisodes    Int      @default(0)
  status           String   // "completed", "incomplete", "dropped"
  imageUrl         String?
  malId            Int?     // MAL id (== AniList idMal); removed @unique for multi-user compatibility
  type             String   @default("TV") // "TV", "Movie", "OVA", "Special"
  originalOrder    Int?     // Preserves the number from 1-601
  watchOrder       Int?     // Custom drag-and-drop ordering for "Currently Watching"
  droppedAt        DateTime?
  completedAt      DateTime?
  airing           Boolean  @default(false)
  broadcastDay     String?
  broadcastTime    String?
  broadcastTimezone String?
  broadcastString  String?
  airingStart      String?
  createdAt        DateTime @default(now())

  // Owner relation
  userId           Int
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Performance indexes and user-scoped uniqueness.
  // Season uniqueness is a PARTIAL unique index covering TV rows only, now part-aware:
  //   CREATE UNIQUE INDEX ... (userId, normalizedName, season, part)
  //     NULLS NOT DISTINCT WHERE type = 'TV'
  // Prisma can't model partial / NULLS NOT DISTINCT indexes, so it lives in the
  // migration 20260605120000_add_season_part (mirror: scripts/migrate-add-season-part.ts),
  // not as an @@unique() here. Movies/OVAs/Specials stay unconstrained.
  @@index([userId, status, createdAt])
  @@index([userId, status, droppedAt])
  @@index([userId, status, completedAt])
  @@index([userId, status, originalOrder])
  @@index([userId, status, watchOrder])
  @@index([userId, normalizedName])
  @@index([userId, malId])
}

/// Shared, user-independent cache of airing data keyed by MAL id.
/// All fields come from AniList (keyed via its idMal); the broadcast day/time are
/// derived from the exact air time and kept in JST for the schedule UI.
model AiringCache {
  malId             Int      @id        // MAL id — the global key
  nextEpisode       Int?                // AniList: next episode number
  nextEpisodeAt     Int?                // AniList: exact air time (unix seconds, UTC)
  broadcastDay      String?             // derived weekly broadcast day (JST)
  broadcastTime     String?             // derived JST time
  broadcastTimezone String?
  broadcastString   String?
  airingStart       String?
  releaseStatus     String   @default("unknown") // "releasing" | "finished" | "unknown"
  syncedAt          DateTime @default(now())

  @@index([releaseStatus, nextEpisodeAt])
  @@index([syncedAt])
}

/// Shared, user-independent cache of MAL relation edges keyed by MAL id.
/// `relations` is a RelationEntry[] = { relation, malId, name }[]. Relations are
/// effectively static, so a long TTL governs refresh (see lib/mal-relations.ts).
model MalRelation {
  malId     Int      @id
  relations Json
  syncedAt  DateTime @default(now())
}
