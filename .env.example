# Database connection string for PostgreSQL (e.g. Neon, local, etc.)
DATABASE_URL="postgresql://username:password@host:port/database_name?sslmode=require"

# Google Sign-In: web OAuth client id (verified as the idToken audience in /api/auth/google).
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# Same web client id, exposed to the browser for the website's Google sign-in button
# (Google Identity Services). The site origin must be listed under "Authorized
# JavaScript origins" for this client in the Google Cloud console.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# Apple Sign In: allowed identityToken audiences for /api/auth/apple — the iOS bundle
# id (native app) plus the web Services ID (Sign in with Apple JS). Defaults to the
# iOS bundle id "com.otakumind.app" if unset.
APPLE_CLIENT_ID=com.otakumind.app,com.otakumind.web
# Web Services ID, exposed to the browser for the website's Apple sign-in button.
NEXT_PUBLIC_APPLE_CLIENT_ID=com.otakumind.web

# Resend transactional email
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="OtakuMind <noreply@yourdomain.com>"
# Canonical site URL — used for password-reset links and email logo
APP_URL="https://your-otakumind-deployment.example.com"

# Razorpay (web one-time purchase). Secret + webhook secret are server-only.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace-with-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-webhook-secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
LIFETIME_PRICE_PAISE=29900

# RevenueCat (iOS in-app purchase webhook). This is a shared secret set as the Authorization header.
REVENUECAT_WEBHOOK_SECRET=replace-with-a-long-random-string
